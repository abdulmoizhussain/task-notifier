<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TaskNotifier" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/colorSecondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="actionBarStyle">@style/TaskNotifier.ActionBar</item>
    </style>

    <style name="TaskNotifier.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="titleTextStyle">@style/TaskNotifier.ActionBar.Title</item>
    </style>

    <style name="TaskNotifier.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TaskNotifier.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.TaskNotifier.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/outline</item>
    </style>

    <style name="Widget.TaskNotifier.Button.Danger" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/danger</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
